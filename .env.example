OPENROUTER_API_KEY=

# Models (LiteLLM form). See PLAN.md section 4.
AGENT_MODEL=openrouter/anthropic/claude-sonnet-5.5
DEV_MODEL=openrouter/anthropic/claude-sonnet-5.5
USER_SIM_MODEL=openrouter/openai/gpt-4.1
# Judge used by tau2 for retail NL assertions (tau2 default is gpt-4.1 on OpenAI direct)
JUDGE_MODEL=openrouter/openai/gpt-4.1

# Exact provider slugs from each model's OpenRouter page; one pinned provider per model
AGENT_PROVIDER=anthropic
USER_SIM_PROVIDER=openai
JUDGE_PROVIDER=openai

APPROVAL_MODE=rule_check
MAX_STEPS_PER_TURN=30
MAX_RETRIES_PER_TURN=2

# Sonnet 5.5 thinking effort (low | medium | high); applied identically to baseline and graph
AGENT_EFFORT=medium

# Serve mode (local Postgres; Neon pooled URL when deployed)
DATABASE_URL=postgresql://localhost:5432/react_agent
# Set to require operator sign-in on the console (leave unset for a local demo):
# OPERATOR_TOKEN=
MCP_TOKEN=
